# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
OWNER_IDS=123456789012345678,987654321098765432
GUILD_ID=123456789012345678

# Random.org Integration (Optional)
# Get your key from https://api.random.org/api-keys/beta
RANDOM_ORG_KEY=your_random_org_api_key

# Ollama Configuration (Optional - for local LLM)
# Default: http://192.168.50.69:11434
OLLAMA_URL=http://localhost:11434

# OpenRouter Configuration (Optional - for hosted LLM)
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your.site.com
OPENROUTER_APP_NAME=xdBot
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku

# Tavily Search Integration (Optional - for LLM web search)
# Get your key from https://tavily.com
# Enables LLMs to search the web for current information
TAVILY_API_KEY=your_tavily_api_key

# Polygon.io Stock Market Integration (Optional - for stock data)
# Get your key from https://polygon.io/dashboard/keys
# Enables stock price commands and LLM stock market tools
POLYGON_API_KEY=your_polygon_api_key

# Logging Configuration (Optional)
# Set to DEBUG to see detailed API requests/responses for LLM and search operations
# Set to INFO (default) for normal operation
# Options: DEBUG, INFO, WARNING, ERROR
LLM_LOG_LEVEL=INFO
